{
  "name": "memstation",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "bash ./scripts/devcontainer/start-fullstack-debug.sh",
    "dev:container": "bash ./scripts/devcontainer/start-workspace.sh",
    "dev:workspace": "bash ./scripts/dev/run-fullstack-workspace.sh",
    "dev:server": "bash ./scripts/dev/run-server-watch.sh",
    "dev:manager:portless": "bash ./scripts/dev/run-manager-portless.sh",
    "dev:reset": "bash ./scripts/dev/reset-compose-stack.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:contract": "bash ./scripts/test/run-contract-tests.sh",
    "test:eval": "bash ./scripts/eval/run-memory-smoke.sh",
    "test:eval:locomo": "bash ./scripts/eval/run-memory-locomo.sh",
    "test:eval:nightly": "bash ./scripts/eval/run-memory-nightly.sh",
    "test:e2e:manager": "pnpm --filter @memstation/manager test:e2e",
    "test:perf": "bash ./scripts/eval/run-performance-smoke.sh",
    "test:recovery": "bash ./scripts/ops/run-worker-recovery-smoke.sh",
    "test:backup:dry-run": "bash ./scripts/ops/run-backup-restore-drill.sh --dry-run",
    "test:coverage": "bash ./scripts/test/check-coverage.sh",
    "test:all": "pnpm lint && pnpm test && pnpm test:contract && pnpm test:eval && pnpm test:e2e:manager",
    "generate": "turbo run generate",
    "format": "turbo run format"
  },
  "devDependencies": {
    "portless": "0.12.0",
    "turbo": "2.8.16"
  }
}
