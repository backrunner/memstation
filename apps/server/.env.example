MEMSTATION_APP_NAME=memstation
MEMSTATION_VERSION=0.1.0
MEMSTATION_PORT=8080
MEMSTATION_GRPC_PORT=9090
MEMSTATION_PUBLIC_BASE_URL=http://127.0.0.1:8080
MEMSTATION_DEFAULT_PROVIDER=openai_compatible
MEMSTATION_INTERNAL_DEFAULT_PROVIDER=openai_compatible
# Local development defaults only. Rotate before sharing or deploying.
MEMSTATION_ADMIN_TOKEN=memstation-local-admin-token
MEMSTATION_MASTER_KEY=memstation-local-master-key
DATABASE_URL=postgres://memstation:memstation_dev@localhost:5432/memstation?sslmode=disable
REDIS_URL=redis://localhost:6379/0
VECTOR_STORE_BACKEND=pgvector
CHAT_MODEL=

# Semantic memory generation requires configured LLMs; there is no rule fallback.
SUMMARY_MODEL=
ANALYSIS_MODEL=
EMBEDDING_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
EMBEDDING_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_BASE_URL=https://api.openai.com/v1
MEMSTATION_PROVIDER_TIMEOUT_SECONDS=60
# Automatic LLM consolidation and tool writes use separate allowlists.
MEMSTATION_KEY_MEMORY_AUTO_KEYS=identity,preferences,projects
MEMSTATION_KEY_MEMORY_WRITE_KEYS=recent_conversation
MEMSTATION_RATE_LIMIT_RPS=20
MEMSTATION_RATE_LIMIT_BURST=40
# Empty means reflect any incoming Origin. Set comma-separated origins to enforce a whitelist.
MEMSTATION_CORS_ALLOWED_ORIGINS=
MEMSTATION_SESSION_COOKIE_SECURE=false
MEMSTATION_SESSION_COOKIE_CROSS_SITE=false
CONVERSATION_TIMEOUT_MINUTES=15
MAX_CONTEXT_TOKENS=8192
MAX_INJECTION_TOKENS=2048
MESSAGE_THRESHOLD=32
TOKEN_THRESHOLD=64000
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional second-stage relevance ranking; leave the model empty to disable.
# Provider: cohere, jina, openrouter, or rerank_compatible.
# Local llama.cpp uses a ranking-capable GGUF and its /rerank endpoint.
MEMSTATION_RERANK_MODEL=
MEMSTATION_RERANK_BASE_URL=http://127.0.0.1:18082
MEMSTATION_RERANK_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Independent memory service. This file contains deployment configuration only;
# Mimic's credential for MemStation is issued separately by Workspace / Agents.
MEMSTATION_MEMORY_AI_BACKEND=direct
MEMSTATION_MEMORY_BROKER_BASE_URL=
MEMSTATION_MEMORY_BROKER_CREDENTIAL=
MEMSTATION_MEMORY_BROKER_SUMMARY_ALIAS=memory.summary
MEMSTATION_MEMORY_BROKER_ANALYSIS_ALIAS=memory.analysis
MEMSTATION_MEMORY_BROKER_EMBEDDING_ALIAS=memory.embedding
MEMSTATION_MEMORY_BROKER_RERANK_ALIAS=memory.rerank
# Immutable actual model revision and fingerprint, not a mutable alias.
MEMSTATION_MEMORY_BROKER_EMBEDDING_MODEL=
MEMSTATION_MEMORY_BROKER_EMBEDDING_DIMENSIONS=0
MEMSTATION_MEMORY_BROKER_EMBEDDING_FINGERPRINT=
# Serialized UTF-8 input upper bound; windows also seal at 100 messages or 5m idle.
MEMSTATION_INGESTION_WINDOW_BUDGET=8192
# Keep this volume independent of database backups. All roles share this file.
MEMSTATION_DELETION_JOURNAL_PATH=./data/deletions/history.jsonl

# Keep this independent journal key stable across upstream encryption-key rotation.
# Empty uses MASTER_KEY for compatibility; preserve that original key when setting this later.
MEMSTATION_DELETION_JOURNAL_KEY=

# Experimental source-grounded semantic episodes; restart server and workers after changes.
MEMSTATION_SEMANTIC_EPISODES_ENABLED=false
# Optional for OpenAI-compatible memory generation, including the AI broker.
# Empty keeps the provider default. Verify supported values for your model.
# This controls internal summary/analysis/scoring, not proxied user requests.
MEMSTATION_MEMORY_REASONING_EFFORT=

# Memory workers have independent reasoning/output budgets and deadlines.
MEMSTATION_MEMORY_MIN_OUTPUT_TOKENS=16384
# Exact provider:model input capabilities; unknown models are text-only.
# Enable modalities only after checking the selected model and endpoint.
MEMSTATION_MODEL_INPUT_MODALITIES={}
MEMSTATION_MEMORY_MAX_OUTPUT_TOKENS=65536
MEMSTATION_MEMORY_LLM_TIMEOUT_SECONDS=300
