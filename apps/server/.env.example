MEMSTATION_APP_NAME=memstation
MEMSTATION_VERSION=0.1.0
MEMSTATION_PORT=8080
MEMSTATION_GRPC_PORT=9090
MEMSTATION_PUBLIC_BASE_URL=http://127.0.0.1:8080
MEMSTATION_DEFAULT_PROVIDER=openai_compatible
MEMSTATION_INTERNAL_DEFAULT_PROVIDER=openai_compatible
# Local development defaults only. Rotate before sharing or deploying.
MEMSTATION_ADMIN_TOKEN=memstation-local-admin-token
MEMSTATION_MASTER_KEY=memstation-local-master-key
MEMSTATION_DEV_API_KEY=ms-local-dev
DATABASE_URL=postgres://memstation:memstation_dev@localhost:5432/memstation?sslmode=disable
REDIS_URL=redis://localhost:6379/0
VECTOR_STORE_BACKEND=pgvector
CHAT_MODEL=

# Semantic memory generation requires configured LLMs; there is no rule fallback.
SUMMARY_MODEL=
ANALYSIS_MODEL=
EMBEDDING_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
EMBEDDING_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_BASE_URL=https://api.openai.com/v1
MEMSTATION_PROVIDER_TIMEOUT_SECONDS=60
# Automatic LLM consolidation and tool writes use separate allowlists.
MEMSTATION_KEY_MEMORY_AUTO_KEYS=identity,preferences,projects
MEMSTATION_KEY_MEMORY_WRITE_KEYS=recent_conversation
MEMSTATION_RATE_LIMIT_RPS=20
MEMSTATION_RATE_LIMIT_BURST=40
# Empty means reflect any incoming Origin. Set comma-separated origins to enforce a whitelist.
MEMSTATION_CORS_ALLOWED_ORIGINS=
MEMSTATION_SESSION_COOKIE_SECURE=false
MEMSTATION_SESSION_COOKIE_CROSS_SITE=false
CONVERSATION_TIMEOUT_MINUTES=15
MAX_CONTEXT_TOKENS=8192
MAX_INJECTION_TOKENS=2048
MESSAGE_THRESHOLD=32
TOKEN_THRESHOLD=64000
OTEL_EXPORTER_OTLP_ENDPOINT=
