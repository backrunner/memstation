{
  "name": "@memstation/server",
  "private": true,
  "scripts": {
    "dev": "go run ./cmd/memstation serve",
    "build": "mkdir -p dist && go build -o dist/memstation ./cmd/memstation",
    "lint": "go vet ./...",
    "test": "go test ./...",
    "test:contract": "go test ./tests/contract/... -count=1",
    "test:eval": "go test ./tests/eval/... -count=1",
    "eval": "go run ./tests/eval/cmd/evalrun",
    "generate": "go generate ./...",
    "format": "find . -name '*.go' -print0 | xargs -0 gofmt -w"
  }
}
