{
  "name": "@memstation/manager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "pnpm run generate && pnpm run check && eslint . --max-warnings 0",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium webkit",
    "test:watch": "vitest",
    "generate": "svelte-kit sync",
    "format": "pnpm run generate && eslint . --fix"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "bits-ui": "2.20.2",
    "echarts": "6.1.0",
    "isomorphic-dompurify": "4.6.0",
    "marked": "18.1.1",
    "shadcn-svelte": "1.7.0",
    "shiki": "4.5.0",
    "svelte": "5.57.2",
    "@lucide/svelte": "1.61.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "svelte-check": "4.7.7",
    "svelte-eslint-parser": "1.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26.12.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
