{
  "name": "@memstation/manager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "pnpm run generate && pnpm run check && eslint . --max-warnings 0",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium webkit",
    "test:watch": "vitest",
    "generate": "svelte-kit sync",
    "format": "pnpm run generate && eslint . --fix"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "5.5.4",
    "@sveltejs/kit": "2.55.0",
    "bits-ui": "2.16.3",
    "echarts": "6.0.0",
    "isomorphic-dompurify": "3.3.0",
    "lucide-svelte": "0.577.0",
    "marked": "17.0.4",
    "shadcn-svelte": "1.1.1",
    "shiki": "4.0.2",
    "svelte": "5.53.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@types/node": "25.5.0",
    "@vitest/coverage-v8": "4.1.0",
    "eslint": "10.0.3",
    "eslint-plugin-svelte": "3.15.2",
    "globals": "17.4.0",
    "svelte-check": "4.4.5",
    "svelte-eslint-parser": "1.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.0.0",
    "vitest": "4.1.0"
  },
  "license": "Apache-2.0"
}
