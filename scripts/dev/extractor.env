# Default extractor weights for local development and benchmarks. Deployments set
# their own reviewed model and immutable revision; these are configuration, not code.
MEMSTATION_EXTRACTOR_BACKEND=gliner
MEMSTATION_MEMORY_PROCESSING_MODEL=fastino/gliner2.5-multi-v1
MEMSTATION_MEMORY_PROCESSING_REVISION=cf5593a5d45e3bbf204b9df621b13b1c0cf25ee3
MEMSTATION_MEMORY_PROCESSING_SPLITTER=char
