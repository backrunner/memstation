{
  "name": "MemStation",
  "dockerComposeFile": ["../deploy/compose/docker-compose.yml"],
  "service": "workspace",
  "runServices": ["workspace", "postgres", "redis"],
  "workspaceFolder": "/workspace/memstation",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8080, 5173],
  "portsAttributes": {
    "8080": {
      "label": "MemStation Server"
    },
    "5173": {
      "label": "MemStation Manager Debug"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "go.useLanguageServer": true,
        "typescript.tsdk": "apps/manager/node_modules/typescript/lib"
      },
      "extensions": [
        "golang.go",
        "svelte.svelte-vscode",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
